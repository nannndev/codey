# Server-side only. Never rename this to VITE_GITHUB_TOKEN.
GITHUB_TOKEN=github_pat_your_read_only_token

# Safe for the browser. Find these in the Appwrite project console.
VITE_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id
VITE_APPWRITE_DATABASE_ID=codetype
VITE_APPWRITE_PROFILES_COLLECTION_ID=profiles
VITE_APPWRITE_RUNS_COLLECTION_ID=runs
VITE_APPWRITE_RUN_SESSIONS_COLLECTION_ID=run_sessions
VITE_APPWRITE_KEYBOARD_STATS_COLLECTION_ID=keyboard_stats
VITE_APPWRITE_DAILY_CHALLENGES_COLLECTION_ID=daily_challenges
VITE_APPWRITE_DAILY_RUNS_COLLECTION_ID=daily_runs

# Server-side only for future Vercel functions. Never expose this with VITE_.
APPWRITE_API_KEY=your_server_api_key

# Optional: self-hosted PeerServer for 1v1 duels (defaults to the PeerJS cloud)
# VITE_PEER_HOST=peer.example.com
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
