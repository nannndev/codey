{
  "functions": {
    "api/**/*.ts": {
      "regions": ["sin1"]
    }
  },
  "rewrites": [
    { "source": "/r/:id", "destination": "/api/share/:id" },
    { "source": "/p/:id", "destination": "/api/share/:id?kind=profile" },
    { "source": "/c/:id", "destination": "/api/share/:id?kind=challenge" },
    { "source": "/history", "destination": "/index.html" },
    { "source": "/statistics", "destination": "/index.html" },
    { "source": "/stats", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/daily", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/profile/:userId", "destination": "/index.html" },
    { "source": "/duel", "destination": "/index.html" },
    { "source": "/race", "destination": "/index.html" },
    { "source": "/arcade", "destination": "/index.html" },
    { "source": "/analytics/keyboard", "destination": "/index.html" },
    { "source": "/donate", "destination": "/index.html" },
    { "source": "/support", "destination": "/index.html" },
    { "source": "/contributors", "destination": "/index.html" },
    { "source": "/achievements", "destination": "/index.html" },
    {
      "source": "/((?!api/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
